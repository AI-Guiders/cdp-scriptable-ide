<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>Cdp.ScriptableIde</RootNamespace>
    <AssemblyName>Cdp.ScriptableIde</AssemblyName>
    <PackageId>AIGuiders.Cdp.ScriptableIde</PackageId>
    <Version>0.1.48</Version>
    <Description>CSX allowlist host for CDP: Debug/Roslyn/Git/Verify/Symbol/SemanticMap/Work/Refactor/Annotate/Insert/Fix/Generate/Body/Settings/Packages/Projects/Solutions facades over IScriptToolBus.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Tomlyn" Version="2.9.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Include="tools/**" />
  </ItemGroup>
</Project>
